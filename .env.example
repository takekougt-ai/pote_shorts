# ローカルでの手動実行・検証用。GitHub Actions では同名の Secrets/Variables を使用します。

# Google Drive 上の動画フォルダID (フォルダURLの https://drive.google.com/drive/folders/<この部分> )
DRIVE_FOLDER_ID=

# Google OAuth (scripts/authorize_google.py で取得。client_id/secretは共通、
# refresh_tokenはDriveアカウント用とYouTubeアカウント用でそれぞれ取得する)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
YOUTUBE_REFRESH_TOKEN=

# TikTok OAuth (scripts/authorize_tiktok.py で取得)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# アプリがContent Posting APIの公開投稿審査(Audit)を通っていない場合は SELF_ONLY のままにしてください
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# YouTube 投稿設定
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_CATEGORY_ID=22
YOUTUBE_TAGS=shorts,ショート動画

# 両プラットフォーム共通で説明欄に追記するハッシュタグ等
HASHTAGS=#shorts

STATE_FILE_PATH=state/queue_state.json
